# Required server-only Freestyle credentials and identifiers.
FREESTYLE_API_KEY=
FREESTYLE_VM_ID=
FREESTYLE_TEAM_ID=

# Optional additional machines selected with /pause/vm?machine=1, /pause/vm?machine=2, etc.
FREESTYLE_API_KEY_1=
FREESTYLE_VM_ID_1=
FREESTYLE_TEAM_ID_1=
FREESTYLE_PROJECT_DIR_1=/home/ubuntu/freeai-video-deepagent
FREESTYLE_API_KEY_2=
FREESTYLE_VM_ID_2=
FREESTYLE_TEAM_ID_2=
FREESTYLE_PROJECT_DIR_2=/home/ubuntu/freeai-video-deepagent


# VM execution settings.
FREESTYLE_PROJECT_DIR=/home/ubuntu/freeai-video-deepagent
FREESTYLE_LINUX_USER=ubuntu

# Set both to the exact production URL when deploying to Vercel.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
