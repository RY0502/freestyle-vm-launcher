# Required server-only Freestyle credentials and identifiers.
FREESTYLE_API_KEY=
FREESTYLE_VM_ID=
FREESTYLE_TEAM_ID=

# Required shared key entered by approved users in the landing page.
# Generate a strong value, for example: openssl rand -base64 32
APP_ACCESS_KEY=

# VM execution settings.
FREESTYLE_PROJECT_DIR=/home/ubuntu/freeai-video-deepagent
FREESTYLE_LINUX_USER=ubuntu

# Set both to the exact production URL when deploying to Vercel.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
